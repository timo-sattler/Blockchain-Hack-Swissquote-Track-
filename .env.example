# Optional settings for `npm run demo`. The demo runs without any of them.
# The scripts do not load this file: export the variables in the shell that starts the demo.
# CHAIN=sepolia
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# TREASURY_PRIVATE_KEY=0x...   # testnet only; otherwise a key is created in bank-server/data/treasury.json
# RECOVERY_DELAY_SECONDS=90
# RELAY_DAILY_LIMIT=10
