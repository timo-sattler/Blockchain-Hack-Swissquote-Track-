# Copy to app/.env.local. Vite only exposes variables prefixed with VITE_.

# Base Sepolia RPC (default: public endpoint)
VITE_RPC_URL=https://sepolia.base.org

# Swissquote share service, escrow agent and event hub. Leave empty to use the dev-server proxy
# (/share, /escrow, /hub -> localhost:8790, :8791, :8787). Set them only when the app is hosted
# elsewhere and the services run on their own HTTPS URLs.
VITE_SHARE_URL=
VITE_ESCROW_URL=
VITE_HUB_URL=

# Bitcoin testnet4 explorer API (balances, UTXOs, broadcasting)
VITE_MEMPOOL_API=https://mempool.space/testnet4/api
