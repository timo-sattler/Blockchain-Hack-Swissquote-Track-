# Copy to app/.env.local. Vite only exposes variables prefixed with VITE_.

# Base Sepolia RPC (default: public endpoint)
VITE_RPC_URL=https://sepolia.base.org

# ERC-4337 bundler (default: Pimlico public endpoint, rate-limited, no key needed)
VITE_BUNDLER_URL=https://public.pimlico.io/v2/84532/rpc

# ERC-7677 paymaster for gasless transactions. Leave empty to pay gas from the wallet's ETH.
# Free Pimlico key: https://dashboard.pimlico.io -> https://api.pimlico.io/v2/84532/rpc?apikey=YOUR_KEY
VITE_PAYMASTER_URL=

# Guardian recovery module (default: the CREATE2 address, same on every chain)
VITE_RECOVERY_MODULE=
# Seconds the owner has to cancel a recovery. 60 for the demo, 259200 (72 h) in production.
VITE_RECOVERY_DELAY=60
# MOCK Swissquote guardian service: cd backend/guardian && npm start
VITE_GUARDIAN_URL=http://localhost:8787
