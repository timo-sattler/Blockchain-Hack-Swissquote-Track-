# Copy to app/.env.local. Vite only exposes variables prefixed with VITE_.

# Base Sepolia RPC (default: public endpoint)
VITE_RPC_URL=https://sepolia.base.org

# Swissquote share service (MPC party B, mocked bank backend) and the event hub for the presentation.
# Leave empty to use the Vite dev-server proxy (/share, /hub -> localhost:8790, :8787). Set them only
# when the app is hosted somewhere else (e.g. Vercel) and the services run on their own HTTPS URLs.
VITE_SHARE_URL=
VITE_HUB_URL=

# Bitcoin testnet4 explorer API (balances, UTXOs, broadcasting)
VITE_MEMPOOL_API=https://mempool.space/testnet4/api
